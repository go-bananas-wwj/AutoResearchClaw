# AutoResearchClaw 控制面容器（研究流水线本体：CLI + 23-stage 编排 + 文献检索 + 写作）。
# 实验沙箱镜像另用官方 researchclaw/docker/Dockerfile(.remote-sensing) 构建，
# 由本容器通过 docker socket 调度（见 docker-compose.yml 注释）。
# Build: docker build -f docker/Dockerfile.control -t researchclaw/control:latest .
# 本地适配：固定 Debian 12，与下方 Docker bookworm 软件源保持一致。
FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

# docker CLI（容器内调度实验沙箱用）+ git/curl（literature & ACP 后端）
# 注：刻意不装 texlive —— 导出的 paper.tex 建议直接在 Overleaf 编译（用户工作流）。
ARG DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn
ARG DOCKER_APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/docker-ce/linux/debian
RUN sed -i "s|http://deb.debian.org/debian-security|${DEBIAN_MIRROR}/debian-security|g; s|http://deb.debian.org/debian|${DEBIAN_MIRROR}/debian|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
        git curl ca-certificates gnupg \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl --retry 4 --retry-all-errors -fsSL "${DOCKER_APT_MIRROR}/gpg" -o /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] ${DOCKER_APT_MIRROR} bookworm stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update && apt-get install -y --no-install-recommends docker-ce-cli \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY researchclaw/ ./researchclaw/
COPY frontend-legacy/ ./frontend/
COPY prompts.default.yaml ./
COPY external/ideaspark/ ./external/ideaspark/
# 本地适配：调研阶段精读/用户上传论文需要真正提取 PDF 正文。
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
RUN pip install --index-url "${PIP_INDEX_URL}" -e '.[pdf]' fastapi "uvicorn[standard]" wsproto feedparser openreview-py beautifulsoup4

# 非 root；uid/gid 对齐宿主用户（bind mount 写 artifacts 不踩权限）
RUN groupadd -r -g 1000 claw && useradd -r -u 1000 -g 1000 -m -s /bin/bash claw && chown -R claw /app
USER claw

ENTRYPOINT ["researchclaw"]
CMD ["--help"]
